rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Legacy login code lookup
    match /logincode/{username} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Users collection: allow single-doc lookup by loginCode before sign-in,
    // require Firebase Auth for listing and mutations.
    match /users/{userId} {
      allow get: if true;
      allow list, create, update: if isSignedIn();
      allow delete: if false;
    }

    function isValidOutlet() {
      let data = request.resource.data;
      return !('routine_preset' in data) || data.routine_preset is list;
    }

    // Operational collections: require authenticated Firebase Auth session.
    match /outlets/{docId} {
      allow read, delete: if isSignedIn();
      allow create, update: if isSignedIn() && isValidOutlet();
    }

    match /material_categories/{docId} {
      allow read, write: if isSignedIn();
    }

    match /materials/{docId} {
      allow read, write: if isSignedIn();
    }

    match /products/{docId} {
      allow read, write: if isSignedIn();
    }

    function isValidDistribution() {
      let data = request.resource.data;
      return data.status in ['DRAFT', 'SENT', 'ARRIVED', 'RECEIVED', 'PARTIALLY_RECEIVED', 'NOT_RECEIVED', 'CANCELLED']
        && data.type in ['ROUTINE', 'ADDITIONAL']
        && (!('delivery_method' in data) || data.delivery_method in ['WAREHOUSE_COURIER', 'SELF_PICKUP', 'GOJEK', 'GRAB', 'MAXIM', 'OTHER'])
        && (!('receipt_photo_url' in data) || data.receipt_photo_url == null || data.receipt_photo_url is string);
    }

    match /material_distributions/{docId} {
      allow read, delete: if isSignedIn();
      allow create, update: if isSignedIn() && isValidDistribution();
    }

    match /material_distribution_items/{docId} {
      allow read, write: if isSignedIn();
    }

    function isOwnerReviewOnlyUpdate() {
      return request.resource.data.outlet_id == resource.data.outlet_id
        && request.resource.data.date == resource.data.date
        && request.resource.data.cash_revenue == resource.data.cash_revenue
        && request.resource.data.qris_revenue == resource.data.qris_revenue
        && request.resource.data.total_sold == resource.data.total_sold;
    }

    match /daily_reports/{docId} {
      allow read, delete: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.date >= request.time - duration.value(8, 'd')
        && request.resource.data.date <= request.time + duration.value(1, 'd');
      allow update: if isSignedIn()
        && (
          resource.data.date >= request.time - duration.value(4, 'd')
          || resource.data.get('review_status', 'PENDING') == 'REJECTED'
          || isOwnerReviewOnlyUpdate()
        );
    }

    match /daily_report_products/{docId} {
      allow read, write: if isSignedIn();
    }

    match /daily_report_expenses/{docId} {
      allow read, write: if isSignedIn();
    }

    match /daily_report_damaged_materials/{docId} {
      allow read, write: if isSignedIn();
    }

    // Internal migration metadata: Admin SDK only
    match /_migrations/{docId} {
      allow read, write: if false;
    }
  }
}
