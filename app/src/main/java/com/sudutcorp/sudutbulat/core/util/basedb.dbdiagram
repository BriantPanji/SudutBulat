// id: dbdiagram ini digunakan sebagai acuan database Firestore
// en: this dbdiagram is used as a reference for the Firestore database


// nama document dari collection users adalah logincode untuk login
Table users { //collection users
  id string [pk]
  uid string // optional Firebase Auth UID
  name string [not null]
  email string [not null]
  username string [not null]
  role UserRole [not null]
  outlet_id string [ref: >? outlets.id]
  is_active boolean [not null, default: true]
  photo_url string // Cloudinary secure_url (folder pp)
}

Table outlets {
  id string [pk]
  name string [not null]
  address string [not null]
  coordinate geopoint [not null]
  is_active boolean [not null, default: true]
  is_open boolean [not null, default: true]
  open_time string [not null, default: '08.00']
  close_time string [not null, default: '21.00']
  daily_target int [not null, default: 2000000]
  // denormalized daily summary cache (updated when daily report is submitted)
  total_revenue int [not null, default: 0]
  total_pieces_sold int [not null, default: 0]
  target_percentage float [not null, default: 0]
  routine_preset array // list of { material_id, quantity } set by Owner/Warehouse
}

Table material_categories {
  id string [pk]
  name string [not null]
  name_lower string [not null, unique]
}

Table materials {
  id string [pk]
  name string [unique]
  cost int
  unit Unit
  category_id string [not null, ref: > material_categories.id]
  is_active boolean [not null, default: true]
}

Table daily_reports {
  id string [pk]
  outlet_id string
  created_by string [ref: >? users.id]
  date timestamp
  cash_revenue int
  qris_revenue int
  total_sold int

  indexes {
    (outlet_id, date) [unique]
  }
}

Table daily_report_damaged_materials {
  id string [pk, ref: - daily_reports.id] // 1 doc per daily_report_id
  daily_report_id string [not null, ref: - daily_reports.id]
  items array // list of { material_id, quantity, note }
}

Table daily_report_expenses {
  id string [pk, ref: - daily_reports.id] // 1 doc per daily_report_id
  daily_report_id string [ref: - daily_reports.id]
  items array // list of { category, amount, note }
}

Table daily_report_products {
  id string [pk, ref: - daily_reports.id] // 1 doc per daily_report_id
  daily_report_id string [not null, ref: - daily_reports.id]
  items array // list of { product_id, quantity, price }
}

Enum expense_category {
  GAS
  PLASTIC_BAG
  OTHER
}

Table products {
  id string [pk]
  name string [not null, unique]
  price int [not null]
  sale_type ProductSaleType [not null, default: 'satuan']
  pcs_per_pack int [not null, default: 1]
  is_active boolean [not null, default: true]
}

Table material_distributions {
  id string [pk]
  outlet_id string [not null, ref: > outlets.id]
  created_by string [not null, ref: > users.id]
  confirmed_by string [ref: > users.id]

  status DistributionStatus [not null, default: 'DRAFT']
  type DistributionType [not null, default: 'ROUTINE']
  delivery_method DeliveryMethod [not null, default: 'WAREHOUSE_COURIER']

  note string(512)
  confirmation_note string(512)
  receipt_photo_url string // Cloudinary secure_url (folder dr)

  created_at timestamp [not null]
  sent_at timestamp
  arrived_at timestamp
  confirmed_at timestamp

  items array // list of { material_id, quantity_sent, quantity_received, note }
}


enum Unit {
  pcs
  gr
  ml
  unit
}

enum ProductSaleType {
  satuan
  bungkus
}

Enum DistributionStatus {
  DRAFT
  SENT
  ARRIVED
  RECEIVED
  PARTIALLY_RECEIVED
  NOT_RECEIVED
  CANCELLED
}

Enum DeliveryMethod {
  WAREHOUSE_COURIER
  SELF_PICKUP
  GOJEK
  GRAB
  MAXIM
  OTHER
}

Enum DistributionType {
  ROUTINE
  ADDITIONAL
}

enum UserRole {
  DEV
  OWNER
  WAREHOUSE
  OUTLET
}
