# ============================================================================
# SUDUTBULAT - FIRESTORE TOOLS CONFIGURATION (TEMPLATE)
# Salin file ini menjadi .env di root project: cp .env.example .env
# ============================================================================

# Cara 1: Gunakan path ke file JSON Service Account (relatif terhadap root project)
# Unduh dari Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Cara 2: Atau isi kredensial Service Account secara langsung di bawah ini
FIREBASE_PROJECT_ID=pemobb-9f67e
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@pemobb-9f67e.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI_PRIVATE_KEY_DI_SINI\n-----END PRIVATE KEY-----\n"

# Opsional: Gunakan Firestore Emulator jika diisi (contoh: 127.0.0.1:8080)
FIRESTORE_EMULATOR_HOST=

# Konfigurasi Seeder Akun (Firebase Authentication)
# Jika SYNC_FIREBASE_AUTH=true, seeder users juga akan membuat/update akun di Firebase Auth
SYNC_FIREBASE_AUTH=true
DEFAULT_USER_PASSWORD=password
